<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.focusvision.pcvr">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- The Khronos OpenXR loader finds the runtime through these; with
         targetSdk >= 30 package visibility hides them unless declared. -->
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>
    <application android:allowBackup="false" android:hasCode="true" android:label="@string/app_name">
        <meta-data android:name="com.htc.vr.content.NumDoFHmd" android:value="6DoF" />
        <meta-data android:name="com.htc.vr.content.NumDoFController" android:value="6DoF" />
        <activity android:name=".MainActivity"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density"
            android:launchMode="singleTask" android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" android:exported="true">
            <!-- NativeActivity loads this library; without it, it looks for
                 libmain.so and the app dies at launch. -->
            <meta-data android:name="android.app.lib_name" android:value="focusvision_native" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.htc.intent.category.VRAPP" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
