{
  "name": "frame_jitter",
  "timeout_sec": 30,
  "config_overrides": {
    "video.framerate": 60,
    "audio.enabled": false
  },
  "client": {
    "pin_source": "status_json",
    "duration_sec": 3.0,
    "tracking_pattern": null,
    "face_pattern": null,
    "capture_haptic": false,
    "capture_sleep_events": false,
    "measure_decode_latency": true,
    "osc_listen_port": null
  },
  "fault_injection": [],
  "stimuli": [
    { "kind": "inject_frame_latency", "at_sec": 0.5, "latency_us": 5000 },
    { "kind": "clear_frame_latency", "at_sec": 1.0 },
    { "kind": "inject_frame_latency", "at_sec": 1.5, "latency_us": 10000 },
    { "kind": "clear_frame_latency", "at_sec": 2.5 }
  ],
  "assertions": {
    "min_frames_decoded": 20,
    "min_idr_frames": 1,
    "min_decode_latency_samples": 15,
    "max_decode_latency_us_p99": 100000
  }
}
